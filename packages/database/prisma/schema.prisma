generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PLACED
  CANCELLED
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  rememberMe Boolean   @default(false)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                Session[]
  addresses               Address[] @relation("UserAddresses")
  defaultAddressId        String?   @unique
  defaultAddress          Address?  @relation("UserDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  orders                  Order[]
  emailVerificationTokens EmailVerificationToken[]
  courierProfile          CourierProfile?
  adminGrant              AdminGrant?
  restaurantMemberships   RestaurantMembership[]
}

model CourierProfile {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    CapabilityStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model AdminGrant {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())
}

model RestaurantMembership {
  id           String                   @id @default(uuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role         RestaurantMembershipRole
  status       CapabilityStatus         @default(PENDING)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([userId, restaurantId])
  @@index([restaurantId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String
  /// Optional pin for delivery-radius checks (customer addresses; branch pin lives on RestaurantBranch).
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  defaultForUser User? @relation("UserDefaultAddress")
  branch         RestaurantBranch?
  orders         Order[]

  @@index([userId])
  @@index([userId, deletedAt])
}

model OperatingCity {
  id        String   @id @default(uuid())
  name      String
  country   String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches RestaurantBranch[]

  @@index([country, isActive])
}

model Restaurant {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  status    RestaurantStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  branches    RestaurantBranch[]
  menus       Menu[]
  memberships RestaurantMembership[]

  @@index([status])
}

model RestaurantBranch {
  id                 String           @id @default(uuid())
  restaurantId       String
  restaurant         Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  addressId          String           @unique
  address            Address          @relation(fields: [addressId], references: [id], onDelete: Restrict)
  operatingCityId    String
  operatingCity      OperatingCity    @relation(fields: [operatingCityId], references: [id], onDelete: Restrict)
  name               String
  status             BranchStatus     @default(INACTIVE)
  latitude           Decimal?         @db.Decimal(9, 6)
  longitude          Decimal?         @db.Decimal(9, 6)
  deliveryRadiusKm   Decimal?         @db.Decimal(6, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  orders Order[]

  @@index([restaurantId])
  @@index([operatingCityId])
  @@index([status])
  @@index([restaurantId, status])
}

model Menu {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  categories MenuCategory[]

  @@index([restaurantId])
}

model MenuCategory {
  id        String   @id @default(uuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]

  @@index([menuId])
}

model MenuItem {
  id             String       @id @default(uuid())
  menuCategoryId String
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  priceCents     Int
  currency       String       @default("USD")
  isAvailable    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orderItems OrderItem[]

  @@index([menuCategoryId])
}

model Order {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurantBranchId String
  restaurantBranch   RestaurantBranch @relation(fields: [restaurantBranchId], references: [id], onDelete: Restrict)
  deliveryAddressId  String
  deliveryAddress    Address          @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  status             OrderStatus      @default(PENDING)
  currency           String           @default("USD")
  totalCents         Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([restaurantBranchId])
}

model OrderItem {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name           String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  createdAt      DateTime  @default(now())

  @@index([orderId])
}

enum CapabilityStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum RestaurantMembershipRole {
  OWNER
  STAFF
}

enum RestaurantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BranchStatus {
  INACTIVE
  ACTIVE
}
