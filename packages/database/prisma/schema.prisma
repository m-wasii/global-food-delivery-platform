generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PLACED
  CANCELLED
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  rememberMe Boolean   @default(false)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                Session[]
  addresses               Address[] @relation("UserAddresses")
  defaultAddressId        String?   @unique
  defaultAddress          Address?  @relation("UserDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  orders                  Order[]
  carts                   Cart[]
  restaurantPreferences   UserRestaurantPreference[]
  emailVerificationTokens EmailVerificationToken[]
  courierProfile          CourierProfile?
  adminGrant              AdminGrant?
  restaurantMemberships   RestaurantMembership[]
  mediaAssets             MediaAsset[]
}

model CourierProfile {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    CapabilityStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model AdminGrant {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())
}

model RestaurantMembership {
  id           String                   @id @default(uuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role         RestaurantMembershipRole
  status       CapabilityStatus         @default(PENDING)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([userId, restaurantId])
  @@index([restaurantId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String
  /// Optional pin for delivery-radius checks (customer addresses; branch pin lives on RestaurantBranch).
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  defaultForUser User? @relation("UserDefaultAddress")
  branch         RestaurantBranch?
  orders         Order[]

  @@index([userId])
  @@index([userId, deletedAt])
}

model OperatingCity {
  id        String   @id @default(uuid())
  name      String
  country   String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches RestaurantBranch[]

  @@index([country, isActive])
}

model MediaAsset {
  id               String   @id @default(uuid())
  /// Storage backend id (e.g. external_url, s3). Swap providers without changing FKs.
  provider         String
  /// Provider-specific object key; null for pure external URLs.
  storageKey       String?
  publicUrl        String
  mimeType         String?
  byteSize         Int?
  /// User who registered the asset; null for legacy rows migrated from inline URLs.
  uploadedByUserId String?
  uploadedBy       User?    @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurantCovers Restaurant[] @relation("RestaurantCoverMedia")
  menuItemImages   MenuItem[]   @relation("MenuItemImageMedia")

  @@index([provider])
  @@index([uploadedByUserId])
}

model Restaurant {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  status       RestaurantStatus @default(PENDING)
  /// Free-form cuisine labels for baseline search (e.g. "Pakistani", "Pizza").
  cuisineTags  String[]         @default([])
  coverMediaId String?
  coverMedia   MediaAsset?      @relation("RestaurantCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  branches      RestaurantBranch[]
  menus         Menu[]
  memberships   RestaurantMembership[]
  carts         Cart[]
  preferences   UserRestaurantPreference[]

  @@index([status])
  @@index([coverMediaId])
}

model RestaurantBranch {
  id                 String           @id @default(uuid())
  restaurantId       String
  restaurant         Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  addressId          String           @unique
  address            Address          @relation(fields: [addressId], references: [id], onDelete: Restrict)
  operatingCityId    String
  operatingCity      OperatingCity    @relation(fields: [operatingCityId], references: [id], onDelete: Restrict)
  name               String
  status             BranchStatus     @default(INACTIVE)
  /// Pause ordering without deactivating the branch (temp closure).
  temporarilyClosed  Boolean          @default(false)
  /// IANA timezone for weekly hours evaluation (e.g. Asia/Karachi).
  timezone           String           @default("UTC")
  latitude           Decimal?         @db.Decimal(9, 6)
  longitude          Decimal?         @db.Decimal(9, 6)
  deliveryRadiusKm   Decimal?         @db.Decimal(6, 2)
  /// Subtotal floor before checkout; null = no minimum.
  minimumOrderCents  Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  orders               Order[]
  weeklyHours          BranchWeeklyHours[]
  exceptions           BranchAvailabilityException[]
  carts                Cart[]
  preferences          UserRestaurantPreference[]
  menuItemAvailability BranchMenuItemAvailability[]

  @@index([restaurantId])
  @@index([operatingCityId])
  @@index([status])
  @@index([restaurantId, status])
}

/// Weekly schedule for a branch. dayOfWeek: 0=Sunday … 6=Saturday (JS Date.getDay).
model BranchWeeklyHours {
  id               String           @id @default(uuid())
  branchId         String
  branch           RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayOfWeek        Int
  /// Minutes from local midnight. Ignored when isClosed.
  openTimeMinutes  Int              @default(0)
  closeTimeMinutes Int              @default(0)
  isClosed         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
}

/// Holiday / special-hours window. Inclusive calendar dates in the branch timezone.
model BranchAvailabilityException {
  id               String           @id @default(uuid())
  branchId         String
  branch           RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startDate        DateTime         @db.Date
  endDate          DateTime         @db.Date
  isClosed         Boolean          @default(true)
  openTimeMinutes  Int?
  closeTimeMinutes Int?
  reason           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([branchId])
  @@index([branchId, startDate, endDate])
}

model Menu {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  categories MenuCategory[]

  @@index([restaurantId])
}

model MenuCategory {
  id        String   @id @default(uuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]

  @@index([menuId])
}

model MenuItem {
  id             String       @id @default(uuid())
  menuCategoryId String
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  imageMediaId   String?
  imageMedia     MediaAsset?  @relation("MenuItemImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  priceCents     Int
  currency       String       @default("USD")
  isAvailable    Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orderItems           OrderItem[]
  cartItems            CartItem[]
  branchAvailabilities BranchMenuItemAvailability[]

  @@index([menuCategoryId])
  @@index([menuCategoryId, sortOrder])
  @@index([imageMediaId])
}

/// Per user + restaurant: remembered fulfillment branch (nearest on first open, then sticky).
model UserRestaurantPreference {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId    String
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  favoredBranchId String
  favoredBranch   RestaurantBranch @relation(fields: [favoredBranchId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@index([favoredBranchId])
}

/// Opt-in: no row ⇒ not offered at this branch. Row + isAvailable=false ⇒ out of stock here.
model BranchMenuItemAvailability {
  id          String           @id @default(uuid())
  branchId    String
  branch      RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  isAvailable Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([branchId, menuItemId])
  @@index([branchId])
  @@index([menuItemId])
}

/// One cart per customer per restaurant. Exists only while it has ≥1 line.
model Cart {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId     String
  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  selectedBranchId String
  selectedBranch   RestaurantBranch @relation(fields: [selectedBranchId], references: [id], onDelete: Restrict)
  currency         String           @default("USD")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items CartItem[]

  @@unique([userId, restaurantId])
  @@index([userId])
  @@index([restaurantId])
  @@index([selectedBranchId])
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity   Int
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cartId, menuItemId])
  @@index([cartId])
  @@index([menuItemId])
}

model Order {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurantBranchId String
  restaurantBranch   RestaurantBranch @relation(fields: [restaurantBranchId], references: [id], onDelete: Restrict)
  deliveryAddressId  String
  deliveryAddress    Address          @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  status             OrderStatus      @default(PENDING)
  currency           String           @default("USD")
  totalCents         Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([restaurantBranchId])
}

model OrderItem {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name           String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  createdAt      DateTime  @default(now())

  @@index([orderId])
}

enum CapabilityStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum RestaurantMembershipRole {
  OWNER
  STAFF
}

enum RestaurantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BranchStatus {
  INACTIVE
  ACTIVE
}
