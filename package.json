{
  "name": "global-food-delivery-platform",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=26.10.0" },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @food-delivery/database db:generate",
    "db:migrate": "pnpm --filter @food-delivery/database db:migrate"
  }
}
