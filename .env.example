NODE_ENV=development
API_PORT=3001
POSTGRES_USER=food_delivery
POSTGRES_PASSWORD=food_delivery
POSTGRES_DB=food_delivery
# For parallel worktrees, choose unique host ports and use them in DATABASE_URL / REDIS_URL.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql://food_delivery:food_delivery@localhost:5432/food_delivery
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000
PARTNER_WEB_URL=http://localhost:3002
# Pricing defaults (minor units of cart currency; tax in basis points). Rich rules: EAT-49 / EAT-70.
PRICING_SERVICE_FEE_MINOR=0
PRICING_DELIVERY_FEE_MINOR=0
PRICING_TAX_RATE_BPS=0
COMMISSION_RATE_BPS=1500
# Customer cancel window from order.createdAt (partner/admin ignore the clock). See ADR 0010.
CUSTOMER_CANCEL_WINDOW_MINUTES=7
